# EMAIL OTP CONFIGURATION (for sending real OTP verification emails to user inboxes)
# Option 1: Gmail SMTP (or any custom SMTP server)
# To use Gmail, create an App Password at: https://myaccount.google.com/apppasswords
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-16-digit-app-password"

# Option 2: Resend API (https://resend.com)
# RESEND_API_KEY="re_your_resend_api_key"

# GEMINI_API_KEY: your Google AI Studio API key (https://aistudio.google.com/apikey)
# This same key is used to call Gemma 4 (gemma-4-31b-it) via the Gemini API -
# Gemma 4 models are served through the same generativelanguage.googleapis.com
# endpoint and @google/genai SDK as Gemini models, so no separate provider or
# key is needed.
GEMINI_API_KEY="your-google-ai-studio-key"

# GROQ_API_KEY: alternative AI provider. If set, /api/ai-coach and
# /api/parse-resume will prefer Groq. Get a key at https://console.groq.com/keys
GROQ_API_KEY="your-groq-api-key"
GROQ_API_URL="https://api.groq.com/openai/v1"
GROQ_MODEL="llama-3.3-70b-versatile"

# GEMMA_MODEL: (optional) override the AI model used by the backend.
# Defaults to gemma-4-31b-it if not set.
GEMMA_MODEL="gemma-4-31b-it"

# JWT_SECRET: (optional but recommended) signs the login session tokens.
# If left unset, a random secret is generated each time the server starts,
# which means everyone gets logged out on every restart/redeploy. Set this
# to a fixed value for persistent sessions, e.g.: openssl rand -hex 32
JWT_SECRET="replace-with-a-long-random-secret"

# ADMIN_EMAIL / ADMIN_PASSWORD: (optional) override the admin login.
# If left unset, the app uses the built-in default admin identity defined in
# src/api/app.ts. Only ONE email/password combination is ever accepted for
# the admin role - set these here (or on your hosting provider) if you want
# to change that identity for a specific deployment without editing code.
ADMIN_EMAIL="venkatakarthikeyavempati@gmail.com"
ADMIN_PASSWORD="rohini123"
