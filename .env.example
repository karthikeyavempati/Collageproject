# Never put real credentials in this file or commit them.
# Add real values to a gitignored local .env file or Vercel Environment Variables.

# Email OTP delivery (configure either SMTP or Resend)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
RESEND_API_KEY=""

# Gemini provider
GEMINI_API_KEY=""
GEMMA_MODEL="gemini-3.6-flash"

# NVIDIA NIM / OpenAI-compatible provider
NVIDIA_API_KEY=""
NVIDIA_API_URL="https://integrate.api.nvidia.com/v1"
NVIDIA_MODEL="google/gemma-4-31b-it"

# Set stable random secrets in Vercel so sessions work across serverless instances.
JWT_SECRET=""

# Admin login stays disabled until these private values are configured.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
